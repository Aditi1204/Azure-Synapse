{
	"name": "Dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_Parquet_Bronze",
						"type": "DatasetReference"
					},
					"name": "sourceBronze"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver",
						"type": "DatasetReference"
					},
					"name": "sinkDestination"
				}
			],
			"transformations": [
				{
					"name": "filterlessthan100"
				},
				{
					"name": "AddDomain"
				},
				{
					"name": "FetchonlyDomain"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderID as string,",
				"          OrderDate as timestamp,",
				"          CustomerID as string,",
				"          CustomerName as string,",
				"          CustomerEmail as string,",
				"          ProductID as string,",
				"          ProductName as string,",
				"          ProductCategory as string,",
				"          RegionID as string,",
				"          RegionName as string,",
				"          Country as string,",
				"          Quantity as string,",
				"          UnitPrice as long,",
				"          TotalAmount as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourceBronze",
				"sourceBronze filter(UnitPrice >=100) ~> filterlessthan100",
				"filterlessthan100 derive(Domain = split(CustomerEmail,'@')) ~> AddDomain",
				"AddDomain derive(Domain = slice(Domain,2)[1]) ~> FetchonlyDomain",
				"FetchonlyDomain sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkDestination"
			]
		}
	}
}